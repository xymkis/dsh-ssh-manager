{
  "name": "@local/dsh-ssh-manager",
  "version": "1.0.0",
  "description": "Manage Linux SSH server connections in DeepSeek Harness and let the agent run remote commands over SSH.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xymkis/dsh-ssh-manager.git"
  },
  "homepage": "https://github.com/xymkis/dsh-ssh-manager#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "linux",
    "remote"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CONTRACT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "scripts": {
    "test": "node scripts/smoke-host.mjs && node verify/preflight.mjs && node verify/ssh-e2e.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
